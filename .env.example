# ==========================================================
# SCANIX AI — environment template
# Copy to `.env` and fill in the keys you have. Everything is
# optional for a basic scan except where noted; missing keys
# degrade gracefully (AI / DB / email features switch off).
# ==========================================================

# --- App ---
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# --- Security (set these before any real deployment) ---
SECRET_KEY=change-me
JWT_SECRET=change-me

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- AI providers (System 6 explainer / nutritionist) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=

# --- Database / storage (System 9) ---
DATABASE_URL=
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# --- Google OAuth (System 9 login) ---
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=

# --- Email (System 8 complaint delivery) ---
SENDGRID_API_KEY=
FROM_EMAIL=complaints@scanix.ai
